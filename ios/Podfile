# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.5'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SmartBaibolyYarn' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Fix deployment target for all pods to ensure compatibility
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      end

      # react-native-quick-sqlite's podspec doesn't define SQLITE_ENABLE_FTS5
      # for its bundled SQLite amalgamation (cpp/sqlite3.c) — without it the
      # FTS5 module compiles out entirely and every FTS query (Bible + Hymn
      # search) throws "no such module: fts5" at runtime, silently degrading
      # to a full-table LIKE scan (no relevance ranking, no prefix index, the
      # trigram fuzzy-typo tables never reachable). Confirmed on Android via
      # the equivalent `quickSqliteFlags` Gradle property
      # (android/gradle.properties) — mirroring the fix here since the iOS
      # side has no equivalent app-level hook of its own.
      if target.name == 'react-native-quick-sqlite'
        target.build_configurations.each do |config|
          defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          defs = [defs] if defs.is_a?(String)
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs + ['SQLITE_ENABLE_FTS5=1']
        end
      end
    end
  end
end
