<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / transfer rules for Android 12+ (API >= 31), referenced by
  android:dataExtractionRules in the manifest.

  Mirrors backup_rules.xml: keep AsyncStorage (favorites, notes, highlights,
  theme) and exclude the bundled Bible/Hymns SQLite DBs under files/default/,
  which re-extract from the APK on launch.

  - cloud-backup: Google Drive auto backup (uninstall/reinstall, new device).
  - device-transfer: direct device-to-device migration.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="default/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="default/" />
    </device-transfer>
</data-extraction-rules>
